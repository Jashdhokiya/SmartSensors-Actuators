# ============================================================================
# Smart Cargo Monitor — Git Ignore Rules
# ============================================================================

# 1. Node & Package Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# 2. Environment Variables & Secret Files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!backend/.env.example
!.env.example

# 3. Production & Web Build Artifacts
dist/
dist-ssr/
build/
out/
.vite/
*.tsbuildinfo
.eslintcache

# 4. Embedded / Arduino / PlatformIO Build Artifacts
.pio/
.pioenvs/
.piolibdeps/
*.hex
*.bin
*.elf
*.o
*.obj
*.d
*.map
*.lst

# 5. OS & System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# 6. IDEs & Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# 7. Logs & Temporary Data
logs/
*.log
*.sqlite
*.sqlite3
temp/
tmp/
