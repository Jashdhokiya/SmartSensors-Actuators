# HTTP REST Server Port
PORT=5000

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_cargo_db

# MQTT Broker Configuration
MQTT_BROKER_URL=mqtt://broker.hivemq.com:1883
MQTT_CLIENT_ID=smart_cargo_backend_01
# MQTT_USERNAME=your_broker_username
# MQTT_PASSWORD=your_broker_password

# MQTT Reliability
MQTT_QOS=1                          # 0=fire-and-forget, 1=at-least-once (recommended)
# MQTT_CLEAN_SESSION=true           # Set false to resume subscriptions across reconnects

# MQTT Last Will and Testament (backend status topic)
# MQTT_LWT_TOPIC=cargo/server/status

# HTTP Security
# CORS_ORIGIN=http://localhost:5173  # Restrict to frontend origin in production
# RATE_LIMIT_WINDOW_MS=60000         # Rate limit window (1 minute)
# RATE_LIMIT_MAX=200                 # Max requests per window per IP
